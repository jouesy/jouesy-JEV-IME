// TSF clients and the server in the same Windows session share a pipe.
inline std::string PipeNameForCurrentSession() {
  DWORD session = 0;
  if (!ProcessIdToSessionId(GetCurrentProcessId(), &session)) {
    // A process-specific fallback fails closed instead of using another session.
    return "\\\\.\\pipe\\JEV_IME_unavailable_" +
           std::to_string(GetCurrentProcessId());
  }
  return "\\\\.\\pipe\\@JEV_pipePrefix@" + std::to_string(session);
}
