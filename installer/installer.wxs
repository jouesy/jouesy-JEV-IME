<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="!(loc.ProductName)" Manufacturer="JEV"
           Version="$(var.ProductVersion)" UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" />
    <util:QueryNativeMachine />
    <Property Id="WINDOWSBUILD">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="JEVINSTALLTYPE">
      <RegistrySearch Id="JevTypeSearch" Root="HKLM" Key="SOFTWARE\JEV-IME" Name="InstallationType" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 22000 AND WIX_NATIVE_MACHINE = 34404)" Message="!(loc.WindowsRequired)" />
    <Launch Condition="Installed OR NOT (JEVINSTALLTYPE = &quot;Scripts&quot;)" Message="!(loc.ScriptInstallExists)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="build_msi_generated\LICENSE.rtf" />
    <!-- Let Windows Installer Restart Manager handle open applications. -->
    <util:CloseApplication Id="CloseJevServer" Target="JEVServer.exe" CloseMessage="yes" RebootPrompt="yes" />
    <util:CloseApplication Id="CloseJevConfig" Target="JEVConfig.exe" CloseMessage="yes" RebootPrompt="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="JEV-IME">
        <Directory Id="DataFolder" Name="data">
          <Directory Id="OpenCCFolder" Name="opencc" />
        </Directory>
        <Directory Id="ScriptsFolder" Name="scripts" />
        <Directory Id="LicensesFolder" Name="licenses" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="JEV 智慧注音" />
    </StandardDirectory>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="Server" Guid="*" Bitness="always64">
        <File Id="ServerFile" Source="!(bindpath.PackageDir)\JEVServer.exe" KeyPath="yes" />
        <!-- Run in each user's own session at sign-in, never as a system service. -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="JEV-IME-Server" Type="string" Value="&quot;[#ServerFile]&quot;" />
      </Component>
      <Component Id="Config" Guid="*" Bitness="always64">
        <File Id="ConfigFile" Source="!(bindpath.PackageDir)\JEVConfig.exe" KeyPath="yes" />
      </Component>
      <Component Id="Tip64" Guid="*" Bitness="always64">
        <File Id="Tip64File" Source="!(bindpath.PackageDir)\JEVTIP_x64.dll" KeyPath="yes" />
      </Component>
      <Component Id="Tip32" Guid="*" Bitness="always64">
        <File Id="Tip32File" Source="!(bindpath.PackageDir)\JEVTIP_x86.dll" KeyPath="yes" />
      </Component>
      <Component Id="InstallMetadata" Guid="*" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\JEV-IME" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\JEV-IME" Name="Version" Type="string" Value="$(var.ProductVersion)" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\JEV-IME" Name="InstallationType" Type="string" Value="MSI" />
      </Component>
      <Component Id="ConfigShortcut" Guid="*" Directory="ApplicationProgramsFolder" Bitness="always64">
        <Shortcut Id="ConfigStartMenu" Name="!(loc.ConfigShortcutName)" Description="!(loc.ConfigShortcutDesc)" Target="[#ConfigFile]" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveJevMenu" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\JEV-IME" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="PackageDocumentation" Guid="*" Bitness="always64">
        <File Source="!(bindpath.PackageDir)\LICENSE.txt" KeyPath="yes" />
        <File Source="!(bindpath.PackageDir)\NOTICE.md" />
        <File Source="!(bindpath.PackageDir)\README.md" />
        <File Source="!(bindpath.PackageDir)\windows-validation.md" />
        <File Source="!(bindpath.PackageDir)\manifest.json" />
        <File Source="!(bindpath.PackageDir)\Install-JEV.ps1" />
        <File Source="!(bindpath.PackageDir)\Uninstall-JEV.ps1" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="DictionaryComponents" Directory="DataFolder">
      <Files Include="!(bindpath.PackageDir)\data\*.txt" />
      <Files Include="!(bindpath.PackageDir)\data\*.json" />
    </ComponentGroup>
    <ComponentGroup Id="OpenCCComponents" Directory="OpenCCFolder">
      <Files Include="!(bindpath.PackageDir)\data\opencc\*" />
    </ComponentGroup>
    <ComponentGroup Id="ScriptComponents" Directory="ScriptsFolder">
      <Files Include="!(bindpath.PackageDir)\scripts\*.ps1" />
    </ComponentGroup>
    <ComponentGroup Id="LicenseComponents" Directory="LicensesFolder">
      <Files Include="!(bindpath.PackageDir)\licenses\**" />
    </ComponentGroup>

    <CustomAction Id="Register64" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[#Tip64File]&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Register32" Directory="INSTALLFOLDER" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[#Tip32File]&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Rollback64" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[#Tip64File]&quot;" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="Rollback32" Directory="INSTALLFOLDER" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /u /s &quot;[#Tip32File]&quot;" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="Unregister64" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[#Tip64File]&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Unregister32" Directory="INSTALLFOLDER" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /u /s &quot;[#Tip32File]&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="Unregister64" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="Unregister32" After="Unregister64" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="Rollback64" After="InstallFiles" Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="Register64" After="Rollback64" Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="Rollback32" After="Register64" Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="Register32" After="Rollback32" Condition="NOT REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
    <Feature Id="MainFeature" Title="!(loc.CoreFeatureTitle)" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="DictionaryComponents" />
      <ComponentGroupRef Id="OpenCCComponents" />
      <ComponentGroupRef Id="ScriptComponents" />
      <ComponentGroupRef Id="LicenseComponents" />
    </Feature>
  </Package>
</Wix>
